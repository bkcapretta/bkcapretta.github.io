---
interface Props {
  title: string;
  backgroundImage: string;
}

const { title, backgroundImage } = Astro.props;
---

<header
  class="relative h-[40vh] min-h-[300px] bg-cover bg-center flex items-center justify-center"
  style={`background-image: url('${backgroundImage}')`}
>
  <div class="absolute inset-0 bg-black bg-opacity-30"></div>
  <h1 class="relative text-3xl md:text-5xl font-bold text-white drop-shadow-lg px-8">
    {title}
  </h1>
</header>
