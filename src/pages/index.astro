---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Bianca Capretta - Home">
  <Navigation />
  <PageHeader title="Bianca Capretta" backgroundImage="/img/home.jpg" />

  <main class="max-w-4xl mx-auto px-4 py-12">
    <!-- Introduction Section -->
    <section class="mb-16">
      <div class="flex flex-col md:flex-row gap-8 items-center">
        <div class="md:w-2/3">
          <p class="text-lg text-gray-700 leading-relaxed mb-4">
            I'm a software engineer by day and an amateur chef by night. It all started in Boston where I studied <em>Computer Science, Cognitive Brain Sciences,</em> and <em>Music</em> at Tufts University. The first 6ish years after college, I worked at Spotify building out personalization features like new playlists, end of year Wrapped, "Smart Shuffle", new Audiobook datasets, and music recommendations on the Home page.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed">
            I'm a software engineer by day and a focaccia amateur chef by night. It all started in Boston where I studied <em>Computer Science, Cognitive Brain Sciences,</em> and <em>Music</em> at Tufts University. The first 6ish years after college, I worked at Spotify building out personalization features like new playlists, end of year Wrapped, "Smart Shuffle", new Audiobook datasets, and music recommendations on the Home page.
          </p>
          <p>
            I started to crave something new... and this led me to Italy to 
            work on an organic vegetable farm, teach English to high schoolers in Turin, and cook
            with a pasta chef in Florence. If you want to read about some of my adventures, check
            out my substack <a href="https://substack.com/@biancacapretta482773/note/p-204964923?utm_source=notes-share-action&r=6jxdd" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">here</a>
          </p>
        </div>
        <div class="md:w-1/3">
          <img src="/img/bianca.jpg" alt="Bianca Capretta" class="w-full rounded-lg shadow-md" />
        </div>
      </div>
    </section>

    <!-- Personal Interests Section -->
    <section class="mb-16">
      <div class="flex flex-col md:flex-row gap-8 items-center">
        <div class="md:w-2/5">
          <img src="/img/cooking.jpg" alt="Cooking" class="w-full rounded-lg shadow-md" />
        </div>
        <div class="md:w-3/5">
          <p class="text-lg text-gray-700 leading-relaxed mb-4">
            In my free time, I love cooking Italian food, hiking through foliage-filled mountains, singing harmonies with my friends, cross-stitching and knitting, learning Italian and Korean, and 
            reading fantasy novels that transport me to another world.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed mb-4">
            In college, I sang in an <a href="https://open.spotify.com/track/6TUoh9bcMrPLK1XzEBqx9d" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">a cappella group</a> and a <a href="https://soundcloud.com/bkcapretta/sets/tufts-jazz-improv-combo" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">jazz improv combo</a> so you can often find me singing to myself. I grew up playing classical piano, and learned to fall in love with Debussy, Mozart, Chopin, Schumann, and Astor Piazzolla.
          </p>
        </div>
      </div>
    </section>

    <!-- Name Translation Section -->
    <section class="mb-16">
      <div class="flex flex-col md:flex-row gap-8 items-center">
        <div class="md:w-2/3">
          <p class="text-lg text-gray-700 leading-relaxed">
            My name directly translates to "white baby goat" in Italian. If you <a href="https://www.google.com/search?q=bianca+capretta&source=lnms&tbm=isch&sa=X&sqi=2&ved=0ahUKEwjNlvysoNrcAhVEFJAKHRbkAroQ_AUICigB&biw=1296&bih=723" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">google</a> my full name and click on 'Images', you will notice me surrounded by white goats. I kid you not (pun intended)!
          </p>
        </div>
        <div class="md:w-1/3">
          <img src="/img/bianca_with_goat.jpg" alt="Bianca with a goat" class="w-full rounded-lg shadow-md" />
        </div>
      </div>
    </section>

    <!-- Playlist -->
    <section class="text-center pb-4">
      <p class="text-lg text-gray-700">
        Here's a playlist of <a href="https://open.spotify.com/playlist/1i5QzjWRd6HqdfJCRh9SJE?si=gi9RfRqkRbyeE01CqaHk5w" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">songs I can't stop listening to</a>!
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
